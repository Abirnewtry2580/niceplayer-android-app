<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#0B1220</item>
        <item name="android:textColorPrimary">#F8FAFC</item>
        <item name="android:textColorSecondary">#94A3B8</item>
        <item name="colorAccent">#22D3EE</item>
        <item name="colorControlNormal">#F8FAFC</item>
        <item name="colorControlActivated">#22D3EE</item>
        <item name="colorControlHighlight">#263247</item>
        <item name="alertDialogTheme">@style/NicePlayerDialogTheme</item>
        <item name="android:alertDialogTheme">@style/NicePlayerDialogTheme</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#050812</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">#050812</item>
    </style>
    <style name="NicePlayerDialogTheme" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:colorBackground">#0B1220</item>
        <item name="android:windowBackground">#0B1220</item>
        <item name="android:textColorPrimary">#F8FAFC</item>
        <item name="android:textColorSecondary">#94A3B8</item>
        <item name="colorAccent">#22D3EE</item>
        <item name="colorControlNormal">#F8FAFC</item>
        <item name="colorControlActivated">#22D3EE</item>
        <item name="colorControlHighlight">#263247</item>
        <item name="buttonBarPositiveButtonStyle">@style/NicePlayerDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/NicePlayerDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/NicePlayerDialogButton</item>
    </style>

    <style name="NicePlayerDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#22D3EE</item>
    </style>

    <style name="NicePlayerPopupTheme" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:colorBackground">#0B1220</item>
        <item name="android:windowBackground">#0B1220</item>
        <item name="android:panelColorBackground">#0B1220</item>
        <item name="android:textColorPrimary">#F8FAFC</item>
        <item name="android:textColorSecondary">#94A3B8</item>
        <item name="colorAccent">#22D3EE</item>
        <item name="colorControlNormal">#F8FAFC</item>
        <item name="colorControlHighlight">#263247</item>
    </style>

</resources>
